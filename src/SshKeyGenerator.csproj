<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;net6.0;net5.0;netstandard2.1;netstandard2.0;net452</TargetFrameworks>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net452'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <PropertyGroup>
    <PackageVersion>$(Version)</PackageVersion>
    <PackageId>SshKeyGenerator</PackageId>    
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/ShawInnes/SshKeyGenerator</RepositoryUrl>
    <PackageProjectUrl>https://github.com/ShawInnes/SshKeyGenerator</PackageProjectUrl>
    <PackageTags>SSH Key Generator OpenSSH KeyGen dotnetcore</PackageTags>
    <Authors>ShawInnes</Authors>
    <Description>A native .NET and .NET Core library for creating SSH RSA keys suitable for use with SSH clients and Git+SSH authentication</Description>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../LICENSE.md" Pack="true" PackagePath="$(PackageLicenseFile)"/>
    <None Include="../README.md" Pack="true" PackagePath="$(PackageReadmeFile)"/>
    <None Include="../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath=""/>
  </ItemGroup>
</Project>
